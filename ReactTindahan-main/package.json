    "@capacitor/android": "^7.4.4",
    "@capacitor/cli": "^7.4.4",
    "@capacitor/core": "^7.4.4",
    "@capacitor/device": "^7.0.3",
    "@capacitor/filesystem": "^7.1.6",
    "@capacitor/share": "^7.0.3",
    "@mui/material": "^7.3.2",
    "@mui/x-date-pickers": "^8.11.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^13.5.0",
    "axios": "^1.13.2",
    "body-parser": "^2.2.1",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "dexie": "^4.2.1",
    "dexie-export-import": "^4.1.4",
    "dexie-react-hooks": "^4.2.0",
    "express": "^5.2.1",
    "react": "^19.1.1",
    "react-datepicker": "^8.7.0",
    "react-dom": "^19.1.1",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.8.2",
    "react-scripts": "^5.0.1",
    "sql.js": "^1.13.0",
    "sqlite3": "^5.1.7",
    "styled-components": "^6.1.19",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "server": "node server/index.js",
    "server:https": "node server/index.js --https",
    "dev": "concurrently \"npm start\" \"npm run server\"",
    "dev:https": "concurrently \"npm start\" \"npm run server:https\"",
    "dev:mobile": "concurrently \"HOST=0.0.0.0 npm start\" \"npm run server\"",
    "start:network": "HOST=0.0.0.0 react-scripts start",
    "start:https": "HTTPS=true react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "cap:sync": "npx cap sync",
    "cap:android": "npx cap open android",
    "cap:ios": "npx cap open ios",
    "android:dev": "npm run build && npx cap sync && npx cap run android",
    "ios:dev": "npm run build && npx cap sync && npx cap run ios",
    "full:dev": "concurrently \"npm start\" \"npm run server\" \"npm run cap:sync\"",
    "mobile:dev": "concurrently \"HOST=0.0.0.0 npm start\" \"npm run server\" \"npm run cap:sync\"",
    "https:dev": "concurrently \"npm run start:https\" \"npm run server:https\"",
    "server:dev": "node server/index.js"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.13"
  }
}
